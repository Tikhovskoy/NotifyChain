# Скопируйте в .env и замените значения. Файл .env в git не попадает.
# Все значения ниже фиктивные.

# --- Django ---------------------------------------------------------------------------------
# В production обязательны SECRET_KEY и ALLOWED_HOSTS. Ключ сгенерируйте командой:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Только для dev-настроек (notifychain.settings.dev). В production DEBUG всегда выключен.
DEBUG=True

# --- Docker Compose ---------------------------------------------------------------------------
# Пароль PostgreSQL. DATABASE_URL и REDIS_URL для контейнеров compose собирает сам.
DB_PASSWORD=change-me

# --- Запуск без Docker (необязательно) --------------------------------------------------------
# По умолчанию SQLite в db.sqlite3 и Redis на localhost.
# DATABASE_URL=postgresql://user:password@localhost:5432/notifychain
# REDIS_URL=redis://localhost:6379/0

# --- Production --------------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True             # редирект на HTTPS (по умолчанию включён)
# TRUST_X_FORWARDED_PROTO=True         # включите, если TLS завершает прокси (nginx, Traefik)
# CORS_ALLOWED_ORIGINS=https://app.example.com
# GUNICORN_WORKERS=3

# --- Лимиты ---------------------------------------------------------------------------------
# Throttling API на пользователя и на анонима (формат DRF: число/секунда|min|hour|day)
API_THROTTLE_USER=120/min
API_THROTTLE_ANON=20/min
# Лимиты провайдеров (в минуту и в час) задаются у каждого Provider в БД.
# RATE_LIMIT_ENABLED=False             # выключить проверку лимитов провайдеров

# --- Провайдеры -------------------------------------------------------------------------------
# Каналы: email -> sms -> push. Заполните тех провайдеров, которыми пользуетесь.

# Email: SMTP (основной)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=robot@example.com
SMTP_PASSWORD=change-me
FROM_EMAIL=robot@example.com

# Email: SendGrid (резервный)
SENDGRID_API_KEY=SG.change-me
SENDGRID_FROM_EMAIL=robot@example.com

# SMS: Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=+10000000000

# Push: Telegram-бот (получатель — chat_id из профиля пользователя)
TELEGRAM_BOT_TOKEN=000000000:change-me
